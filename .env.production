# ==========================================================
# AI DATA ANALYST OS - PRODUCTION CONFIGURATION
# ==========================================================

APP_NAME="AI Data Analyst OS"
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=WARNING

# LLM Providers
DEFAULT_LLM=llama-3.3-70b-versatile
DEFAULT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_analyst_prod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=prod_secure_password_9921
DATABASE_URL=postgresql+psycopg://postgres:prod_secure_password_9921@postgres:5432/ai_analyst_prod

# Redis High Availability
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Vector Store
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# Security & Secrets
JWT_SECRET_KEY=prod_super_secure_jwt_secret_key_long_enough_256
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Production Network
CORS_ORIGINS=["https://app.aidataanlayst.com"]
ALLOWED_HOSTS=["app.aidataanlayst.com", "api.aidataanlayst.com"]
SSL_REDIRECT=true
