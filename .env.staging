# ==========================================================
# AI DATA ANALYST OS - STAGING CONFIGURATION
# ==========================================================

APP_NAME="AI Data Analyst OS [Staging]"
ENVIRONMENT=staging
DEBUG=false
LOG_LEVEL=INFO

DEFAULT_LLM=llama-3.3-70b-versatile
DEFAULT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_analyst_staging
POSTGRES_USER=postgres
POSTGRES_PASSWORD=staging_secret_password
DATABASE_URL=postgresql+psycopg://postgres:staging_secret_password@postgres:5432/ai_analyst_staging

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/1

CHROMA_HOST=chromadb
CHROMA_PORT=8000

JWT_SECRET_KEY=staging_super_secret_jwt_key_256bit
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=["https://staging.aidataanlayst.com"]
ALLOWED_HOSTS=["staging.aidataanlayst.com"]
SSL_REDIRECT=true
